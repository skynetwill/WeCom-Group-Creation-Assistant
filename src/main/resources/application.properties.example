# 服务端口
server.port=8082

# 企业微信配置（请替换为你自己的 corpid、corpsecret 和 agentid）
wechat.work.corpid=请替换为你的企业ID
wechat.work.corpsecret=请替换为你的应用密钥
wechat.work.agentid=请替换为你的应用AgentId

# 应用访问地址（OAuth授权回调地址）
app.base-url=请替换为你的应用访问地址（如 https://xxx.ngrok-free.dev）

# ===================== 登录认证配置 =====================
# enabled=true: 启用用户名密码登录，访问 /index.html 和 /api/group/** 需登录
# enabled=false: 保持现有 OAuth 流程不变（默认值）
app.auth.enabled=false
app.auth.default-username=admin
app.auth.default-password=admin123

# ===================== 数据库配置 =====================
# MySQL 连接（请替换为你自己的数据库地址、用户名和密码）
spring.datasource.url=jdbc:mysql://localhost:3306/wechat_group?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&createDatabaseIfNotExist=true
spring.datasource.username=root
spring.datasource.password=请替换为你的数据库密码
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# JPA 配置（开发阶段用 update 自动建表，生产环境改为 validate 或 none）
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect
spring.jpa.properties.hibernate.format_sql=true

# 文件上传大小限制
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB
