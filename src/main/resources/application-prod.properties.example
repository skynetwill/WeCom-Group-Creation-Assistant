# ===================== 生产环境配置模板 =====================
# 复制此文件为 application-prod.properties 并填入实际值

app.auth.enabled=true

wechat.work.corpid=请替换
wechat.work.corpsecret=请替换
wechat.work.agentid=请替换

spring.datasource.url=jdbc:mysql://localhost:3306/wechat_group?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai
spring.datasource.username=wechat_app
spring.datasource.password=请替换
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=false
logging.level.com.school.wechatgroup=INFO

# ===================== HikariCP 连接池优化 =====================
spring.datasource.hikari.connection-timeout=30000
spring.datasource.hikari.maximum-pool-size=20
spring.datasource.hikari.minimum-idle=5
spring.datasource.hikari.idle-timeout=600000
spring.datasource.hikari.max-lifetime=1800000
spring.datasource.hikari.connection-test-query=SELECT 1
